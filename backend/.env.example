# ============================================================
# 1Fi Marketplace Backend — Environment Variables
# Copy to .env and fill in your Supabase values.
# NEVER commit .env to git.
# ============================================================

# Supabase PostgreSQL connection (Transaction pooler — port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection (for migrations — port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Server port
PORT=3000

# Flutter app URL (for CORS) — use your device IP for local dev
FRONTEND_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"
