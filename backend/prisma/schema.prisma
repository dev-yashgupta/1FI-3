// 1Fi Marketplace — Database Schema
// PostgreSQL via Supabase

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  brand       String?
  category    String?
  mrp         Float
  price       Float
  image       String
  rating      Float     @default(0)
  reviewCount Int       @default(0) @map("review_count")
  badges      String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  variants    Variant[]
  emiPlans    EmiPlan[]

  @@map("products")
}

model Variant {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  color     String?
  colorHex  String?  @map("color_hex")
  storage   String?
  finish    String?
  price     Float
  mrp       Float    @default(0)
  image     String?
  inStock   Boolean  @default(true) @map("in_stock")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("variants")
}

model EmiPlan {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  monthlyAmount Float    @map("monthly_amount")
  tenureMonths  Int      @map("tenure_months")
  interestRate  Float    @map("interest_rate")
  cashback      Float    @default(0)
  tag           String   @default("")
  bankName      String   @default("1Fi Credit") @map("bank_name")
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("emi_plans")
}
